7:["$","div",null,{"className":"space-y-8 text-[15px] md:text-[16px] leading-relaxed text-white/70","children":[["$","p",null,{"children":"Your Mac stays entirely yours. Nix is designed from the ground up to respect your privacy and run as quietly as possible."}],["$","section",null,{"children":[["$","h2",null,{"className":"text-xl font-medium text-white mb-3","children":"What Nix Collects Locally"}],["$","p",null,{"children":["Nix stores all of its operational data — including your app rules, grace period settings, and whitelist preferences — strictly on your local machine using standard macOS ",["$","code",null,{"children":"UserDefaults"}],". None of this data is ever transmitted off your device. There is no analytics SDK, no crash reporter, and no usage tracking."]}],["$","p",null,{"className":"mt-3","children":"Nix uses the Accessibility API solely to observe window lifecycle events (open/close). It never reads window content, text fields, or screen data."}]]}],["$","section",null,{"children":[["$","h2",null,{"className":"text-xl font-medium text-white mb-3","children":"License Validation (Lemon Squeezy)"}],["$","p",null,{"children":"The only network activity Nix performs is a single, secure license check when you activate the app. We partner with Lemon Squeezy as our Merchant of Record to process payments and issue licenses."}],["$","p",null,{"className":"mt-3","children":"During activation, Nix sends three pieces of information to Lemon Squeezy to validate your purchase:"}],["$","ul",null,{"className":"list-disc pl-5 mt-3 space-y-2","children":[["$","li",null,{"children":"Your license key"}],["$","li",null,{"children":"An anonymized device instance ID (to manage activation limits)"}],["$","li",null,{"children":"Your email address (if accessing the customer portal)"}]]}],["$","p",null,{"className":"mt-3","children":"This validation ensures your license is valid. Once validated, the status is securely cached in your local macOS Keychain."}]]}],["$","section",null,{"children":[["$","h2",null,{"className":"text-xl font-medium text-white mb-3","children":"No Third Parties"}],["$","p",null,{"children":"Aside from the Lemon Squeezy license check, no other third party is involved. Nix never phones home, never profiles your app usage, and has absolutely no other network code built into the app."}]]}],["$","section",null,{"children":[["$","h2",null,{"className":"text-xl font-medium text-white mb-3","children":"This Website"}],["$","p",null,{"children":"This marketing website is a static site hosted on Vercel. It does not use cookies, does not collect personal data, and does not run third-party analytics. The Nix application and this website are entirely separate codebases."}]]}],["$","section",null,{"children":[["$","h2",null,{"className":"text-xl font-medium text-white mb-3","children":"Refunds"}],["$","p",null,{"children":["Not satisfied with Nix? Email ",["$","a",null,{"href":"mailto:support@nixapp.com","className":"text-white hover:underline transition-all","children":"support@nixapp.com"}]," within 14 days of purchase for a full refund, no questions asked."]}]]}],["$","section",null,{"children":[["$","h2",null,{"className":"text-xl font-medium text-white mb-3","children":"Contact"}],["$","p",null,{"children":["If you have any questions about this policy or how Nix handles your data, please contact us at ",["$","a",null,{"href":"mailto:support@nixapp.com","className":"text-white hover:underline transition-all","children":"support@nixapp.com"}],"."]}]]}]]}]
