22:Tae2,{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"Does Nix force-kill apps?","acceptedAnswer":{"@type":"Answer","text":"Never. Nix sends a standard termination request, the same signal as ⌘Q. The app handles its own shutdown, saves unsaved work, and exits cleanly."}},{"@type":"Question","name":"Will it interfere with apps I want to keep running?","acceptedAnswer":{"@type":"Answer","text":"No. Add anything to the whitelist (Spotify, Slack, mail clients, background tools) and Nix will leave them alone. You can also set per-app rules: Quit, Hide, Ignore, or Prompt."}},{"@type":"Question","name":"How much CPU and memory does Nix use?","acceptedAnswer":{"@type":"Answer","text":"Effectively zero. Nix is event-driven via AXObserver — it doesn't poll. When nothing happens, nothing runs. Idle CPU is 0.0%."}},{"@type":"Question","name":"Does Nix collect any data?","acceptedAnswer":{"@type":"Answer","text":"None. Zero analytics, zero crash reporters, zero tracking. The only network call is license activation via Lemon Squeezy."}},{"@type":"Question","name":"What happens after the trial if I don't buy?","acceptedAnswer":{"@type":"Answer","text":"The background monitoring engine will pause, but all your per-app rules and settings are safely preserved on your Mac. They will instantly reactivate whenever you purchase a license."}},{"@type":"Question","name":"Which macOS versions are supported?","acceptedAnswer":{"@type":"Answer","text":"macOS 14.6 and later. Universal binary — runs natively on Apple Silicon and Intel."}},{"@type":"Question","name":"Is Nix free?","acceptedAnswer":{"@type":"Answer","text":"Nix includes a 7-day free trial. After that, unlock the full version with a one-time $9.99 purchase. No subscriptions. No accounts. No cloud services."}},{"@type":"Question","name":"Does Nix need Accessibility permissions?","acceptedAnswer":{"@type":"Answer","text":"Yes. macOS requires Accessibility access for Nix to observe window-close events. Permission is granted once in System Settings — Nix never uses it for anything else."}},{"@type":"Question","name":"How does Nix update?","acceptedAnswer":{"@type":"Answer","text":"Nix updates itself automatically via Sparkle. You'll see a prompt when a new version is available."}},{"@type":"Question","name":"Is Nix on the Mac App Store?","acceptedAnswer":{"@type":"Answer","text":"No. Nix is distributed as a signed and notarized DMG directly from our website. This lets us ship updates faster and use the Accessibility API without App Store restrictions."}},{"@type":"Question","name":"What's the refund policy?","acceptedAnswer":{"@type":"Answer","text":"Not satisfied? Email support@nixapp.com within 14 days of purchase for a full refund, no questions asked."}}]}18:["$","section",null,{"id":"faq","className":"relative py-28 md:py-36 border-t border-white/[0.06]","data-testid":"faq-section","children":[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$22"}}],["$","div",null,{"className":"mx-auto max-w-3xl px-5","children":[["$","$Lf",null,{"children":["$","div",null,{"className":"text-center","children":[["$","div",null,{"className":"text-[12px] uppercase tracking-[0.18em] text-white/40 mb-5","children":"FAQ"}],["$","h2",null,{"className":"text-4xl md:text-5xl lg:text-6xl font-semibold tracking-[-0.035em] leading-[1.05] text-white","children":"Questions, answered."}]]}]}],"$L23"]}]]}]
